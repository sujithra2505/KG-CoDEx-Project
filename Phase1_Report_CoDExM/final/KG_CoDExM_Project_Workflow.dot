// Workflow pipeline of the CoDEx-M rule-based KG completion project (editable Graphviz source)
// Render: dot -Tpng -Gdpi=220 KG_CoDExM_Project_Workflow.dot -o KG_CoDExM_Project_Workflow.png
digraph WF {
  graph [layout=neato, splines=line, pad=0.3, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=14, width=2.55, height=0.95, fixedsize=true, penwidth=1.6, fillcolor="#eaf2fc", color="#2a78d6"];
  edge [color="#3d3d3a", penwidth=1.7, arrowsize=0.9, fontname="Helvetica", fontsize=11];

  s1 [pos="0,3.2!",  label=<<B>1. CoDEx-M</B><BR/>Dataset>, fillcolor="#f6f6f4", color="#7a7974"];
  s2 [pos="3,3.2!",  label=<<B>2. Dataset</B><BR/>Inspection and<BR/>Validation>];
  s3 [pos="6,3.2!",  label=<<B>3. Training Graph</B><BR/>Construction>, fillcolor="#dcecdc", color="#008300"];
  s4 [pos="9,3.2!",  label=<<B>4. RDF/OWL</B><BR/>Ontology Generation>, fillcolor="#dcecdc", color="#008300"];
  s5 [pos="0,1.2!", label=<<B>5. Rule Mining</B><BR/>and Selection<BR/>(validation review)>, fillcolor="#dcecdc", color="#c98500", penwidth=2.4];
  s6 [pos="3,1.2!",  label=<<B>6. Candidate Triple</B><BR/>Generation>, fillcolor="#dcecdc", color="#008300"];
  s7 [pos="6,1.2!",  label=<<B>7. V1/V2</B><BR/>Ranking>, fillcolor="#dcecdc", color="#008300"];
  s8 [pos="9,1.2!",  label=<<B>8. Validation-Based</B><BR/>Cap Selection>, fillcolor="#fff3d6", color="#c98500"];
  s9 [pos="0,-0.8!",  label=<<B>9. Final Test</B><BR/>Evaluation<BR/>(cap 1,000 · V2)>, fillcolor="#fde3e3", color="#e34948"];
  s10 [pos="3,-0.8!", label=<<B>10. Results and</B><BR/>Dashboards>, fillcolor="#e9e6fb", color="#6250d6"];
  b  [pos="7.5,-0.8!", width=4.0, height=1.0, label=<<B>Earlier baseline:</B> cap-100 V1 and V2<BR/>evaluated on the test split<BR/>(before cap selection)>, fillcolor="#fde3e3", color="#e34948", style="rounded,filled,dashed"];

  s1 -> s2; s2 -> s3; s3 -> s4;
  node [shape=point, width=0.01, style=invis, label=""];
  c1 [pos="9,2.2!"]; c2 [pos="0,2.2!"]; c3 [pos="9,0.2!"]; c4 [pos="0,0.2!"];
  s4 -> c1 [arrowhead=none]; c1 -> c2 [arrowhead=none]; c2 -> s5;
  s5 -> s6; s6 -> s7; s7 -> s8;
  s8 -> c3 [arrowhead=none]; c3 -> c4 [arrowhead=none]; c4 -> s9; s9 -> s10;
  s7 -> b [style=dashed, color="#e34948"];
  b -> s10 [style=dashed, color="#e34948"];

  node [shape=plain, style="", fontsize=12, fontcolor="#3d3d3a", width=0, height=0, fixedsize=false];
  lg [pos="4.5,-1.95!", label=<<TABLE BORDER="0" CELLSPACING="6"><TR>
   <TD BGCOLOR="#dcecdc" BORDER="1" COLOR="#008300" WIDTH="18"> </TD><TD ALIGN="LEFT">training data only</TD>
   <TD BGCOLOR="#fff3d6" BORDER="1" COLOR="#c98500" WIDTH="18"> </TD><TD ALIGN="LEFT">validation split</TD>
   <TD BGCOLOR="#fde3e3" BORDER="1" COLOR="#e34948" WIDTH="18"> </TD><TD ALIGN="LEFT">test split</TD>
   <TD BGCOLOR="#e9e6fb" BORDER="1" COLOR="#6250d6" WIDTH="18"> </TD><TD ALIGN="LEFT">interfaces</TD></TR></TABLE>>];
}
