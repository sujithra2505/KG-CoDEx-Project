// Visualisation of real triples from outputs/phase3/codexm_train_ontology.trig (lines 68506-68508, 105648, 204412-204414, 236818-236820, provenance graph)
digraph ONT {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.25, ranksep=0.5, pad=0.2];
  node [fontname="Helvetica", fontsize=9.5, shape=ellipse, style=filled, fillcolor="#eaf2fc", color="#2a78d6"];
  edge [fontname="Helvetica", fontsize=8.5, color="#52514e", fontcolor="#52514e", arrowsize=0.6];
  subgraph cluster_train { label=<<B>Named graph urn:codexm:graph:train</B> (asserted training triples only)>; style=rounded; color="#008300";
    KJ [label="entity:Q238402"]; JJ [label="entity:Q361297"]; JA [label="entity:Q131324"]; LT [label="entity:Q217427"]; US [label="entity:Q30"];
    JJ -> KJ [label="relation:P26"]; KJ -> JA [label="relation:P40"]; KJ -> LT [label="relation:P40"]; KJ -> US [label="relation:P27"];
  }
  subgraph cluster_labels { label=<<B>Named graph urn:codexm:graph:labels</B>>; style=rounded; color="#c98500";
    KJ2 [label="entity:Q238402"]; NI [label="owl:NamedIndividual", shape=box, fillcolor="#fff3d6", color="#c98500"];
    L1 [label="\"Katherine Jackson\"@en", shape=note, fillcolor="#f7f7f5", color="#9a9994"]; S1 [label="\"Q238402\"", shape=note, fillcolor="#f7f7f5", color="#9a9994"];
    R26 [label="relation:P26"]; OP [label="owl:ObjectProperty", shape=box, fillcolor="#fff3d6", color="#c98500"]; L2 [label="\"spouse\"@en", shape=note, fillcolor="#f7f7f5", color="#9a9994"];
    KJ2 -> NI [label="rdf:type"]; KJ2 -> L1 [label="rdfs:label"]; KJ2 -> S1 [label="vocab:sourceId"];
    R26 -> OP [label="rdf:type"]; R26 -> L2 [label="rdfs:label"];
  }
  subgraph cluster_prov { label=<<B>Named graph urn:codexm:graph:provenance</B>>; style=rounded; color="#6250d6";
    D [label="dataset:train", fillcolor="#e9e6fb", color="#6250d6"]; P1 [label="\"data/train.txt\"", shape=note, fillcolor="#f7f7f5", color="#9a9994"];
    P2 [label="185584 (xsd:integer)", shape=note, fillcolor="#f7f7f5", color="#9a9994"]; P3 [label="\"3B.1.0\"", shape=note, fillcolor="#f7f7f5", color="#9a9994"];
    D -> P1 [label="vocab:sourceFile"]; D -> P2 [label="vocab:uniqueTripleCount"]; D -> P3 [label="vocab:converterVersion"];
  }
}
