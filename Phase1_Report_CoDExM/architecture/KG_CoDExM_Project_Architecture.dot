// Architecture of the Proposed Rule-Based Knowledge Graph Completion System Using CoDEx-M
// Editable source (Graphviz DOT). Render: dot -Tpng -Gdpi=200 KG_CoDExM_Project_Architecture.dot -o KG_CoDExM_Project_Architecture.png
// Every box corresponds to a script or output in the project repository (verified 29 Oct 2026).
digraph ARCH {
  graph [rankdir=TB, fontname="Helvetica", fontsize=13, nodesep=0.35, ranksep=0.42, newrank=true, splines=spline, pad=0.3,
         label=<<B>Architecture of the Proposed Rule-Based Knowledge Graph Completion System Using CoDEx-M</B>>, labelloc=t];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10.5, fillcolor="#eaf2fc", color="#2a78d6", penwidth=1.3, margin="0.14,0.07"];
  edge  [color="#52514e", penwidth=1.2, arrowsize=0.7, fontname="Helvetica", fontsize=9, fontcolor="#52514e"];

  subgraph cluster_in {
    label=<<B>1. Input and data preparation</B>>; style="rounded"; color="#9a9994"; fontsize=12;
    train [label=<<B>Training split</B><BR/>data/train.txt<BR/>185,584 triples · 17,050 entities · 51 relations>, fillcolor="#dcecdc", color="#008300"];
    valid [label=<<B>Validation split</B><BR/>valid.txt 10,310 positives<BR/>valid_negatives.txt 10,310 supplied negatives>, fillcolor="#fff3d6", color="#c98500"];
    test  [label=<<B>Test split</B><BR/>test.txt 10,311 positives<BR/>test_negatives.txt 10,311 supplied negatives>, fillcolor="#fde3e3", color="#e34948"];
    labels [label=<<B>Display labels</B><BR/>entity_labels.json · relation_labels.json<BR/>(presentation only; IDs are processing keys)>, fillcolor="#f3f3f1", color="#9a9994"];
    p1 [label=<<B>Phase 1: Dataset inspection and split verification</B><BR/>row format, duplicates, ID checks, label coverage,<BR/>zero overlap between positive splits (phase1_dataset_report.md)>];
  }

  subgraph cluster_kg {
    label=<<B>2. Graph and ontology construction (training data only)</B>>; style="rounded"; color="#9a9994"; fontsize=12;
    p2 [label=<<B>Phase 2: Training knowledge graph</B> (phase2_graph.py)<BR/>NetworkX MultiDiGraph: 17,050 entity nodes,<BR/>185,584 relation-labelled directed edges>];
    p2out [label=<training_graph.graphml · graph_statistics.json<BR/>interactive_graph.html (entity search, neighbourhood, relation filter)>, fillcolor="#f7f7f5", color="#9a9994"];
    p3 [label=<<B>Phase 3: RDF/OWL ontology dataset</B> (phase3_ontology.py)<BR/>codexm_train_ontology.trig — three named graphs:<BR/>train (185,584) · labels (51,303) · provenance (23)<BR/>owl:NamedIndividual / owl:ObjectProperty only; no domain/range axioms>];
  }

  subgraph cluster_rules {
    label=<<B>3. Rule learning and prediction</B>>; style="rounded"; color="#9a9994"; fontsize=12;
    p4 [label=<<B>Phase 4: Rule mining</B> (phase4_rule_mining.py)<BR/>reads named graph urn:codexm:graph:train only<BR/>1- and 2-atom rules: symmetry, inverse, subrelation, chain, reversed chain<BR/>support · standard conf · PCA conf · head coverage · lift · Wilson bound<BR/>hub caps, redundancy filter, 90/10 stability check>];
    p4v [label=<<B>Rule threshold review on validation</B><BR/>(phase4_rule_evaluation.py, phase4_compare_runs.py)<BR/>min PCA 0.10, min support 10; 6 rules excluded<BR/>→ frozen 160-rule set (33 head relations)>];
    p5 [label=<<B>Phase 5: Candidate generation</B> (phase5_predict.py, one round)<BR/>apply rules to training facts: 212,342 rule×pair records<BR/>− 65,813 already in training · − 27,855 duplicates merged<BR/>= 184,487 unique candidate triples (with groundings)>];
    v1 [label=<<B>Ranking V1</B><BR/>score = max Wilson lower bound<BR/>ties: PCA conf → #rules → subject ID → object ID>];
    v2 [label=<<B>Ranking V2</B> (phase5_rank_v2.py)<BR/>same score<BR/>ties: PCA conf → distinct body matches → #rules → IDs>];
    cap [label=<<B>Per-relation cap</B><BR/>100 (baseline, outputs/phase5) · 250 · 500 · 1,000<BR/>(cap_experiment.py generate; baseline never rewritten)>];
  }

  subgraph cluster_eval {
    label=<<B>4. Evaluation and output</B>>; style="rounded"; color="#9a9994"; fontsize=12;
    ui [label=<<B>Prediction explorer</B> (phase5_ui_build.py)<BR/>graph view, prediction table, entity search, filters,<BR/>provenance panel, V1 vs V2 comparison>, fillcolor="#e9e6fb", color="#6250d6"];
    e6 [label=<<B>Phase 6: test evaluation of cap-100 V1 and V2</B><BR/>(phase6_evaluate.py — first use of the test split)<BR/>TP 257 / 278 · FP 13 / 13>, fillcolor="#fde3e3", color="#e34948"];
    sel [label=<<B>Validation-based configuration selection</B><BR/>rule A1 frozen before validation: maximise recall subject to<BR/>Wilson lower bound of precision ≥ cap-100 bound − 0.05<BR/>8 configurations → selected cap 1,000 · V2>, fillcolor="#fff3d6", color="#c98500"];
    tf [label=<<B>Final test evaluation of cap 1,000 · V2</B><BR/>(cap_experiment.py test — second use of the test split)<BR/>23,772 predictions · TP 927 · FP 73 · unlabelled 22,772>, fillcolor="#fde3e3", color="#e34948"];
    met [label=<<B>Metrics</B>: benchmark precision TP/(TP+FP) · recall TP/|positives|<BR/>F1 = 2TP/(2TP+FP+FN) · positive hit rate TP/|predictions|<BR/>unlabelled predictions are not counted as false>, fillcolor="#f7f7f5", color="#9a9994"];
    dash [label=<<B>Cap-comparison dashboard</B> (cap_dashboard_build.py)<BR/>validation charts for all caps, validation table,<BR/>test table (cap-100 V1/V2, cap-1,000 V2)>, fillcolor="#e9e6fb", color="#6250d6"];
    rep [label=<<B>Saved outputs and reproducibility records</B><BR/>predictions.json, CSV/JSON results, Markdown reports,<BR/>SHA-256 manifests, overwrite refusal, unit tests>, fillcolor="#f7f7f5", color="#9a9994"];
  }

  subgraph cluster_future {
    label=<<B>Proposed future extensions (not implemented)</B>>; style="rounded,dashed"; color="#9a9994"; fontsize=12;
    fut [label=<ontology-aware scoring · longer rules and constants · calibrated confidence<BR/>filtered MRR / Hits@K ranking protocol · embedding and neural baselines>, style="rounded,dashed", fillcolor="white", color="#9a9994", fontcolor="#52514e"];
  }

  // structural checks
  train -> p1; valid -> p1 [style=dotted]; test -> p1 [style=dotted, label=" structural\n checks only"]; labels -> p1 [style=dotted];
  // training flow
  p1 -> p2 [label=" train.txt only", color="#008300", penwidth=1.8];
  labels -> p2 [style=dotted]; labels -> p3 [style=dotted];
  p2 -> p2out; p1 -> p3 [label=" train.txt + labels\n (built independently of Phase 2)", color="#008300", penwidth=1.8];
  p3 -> p4 [label=" training named graph", color="#008300", penwidth=1.8];
  p4 -> p4v;
  valid -> p4v [color="#c98500", style=dashed, label=" validation"];
  p4v -> p5 [label=" 160 rules"];
  p2out -> p5 [label=" GraphML training facts", color="#008300", penwidth=1.8];
  p5 -> v1; p5 -> v2; v1 -> cap; v2 -> cap;
  cap -> ui [label=" cap-100 V1/V2"];
  cap -> e6 [label=" cap 100"];
  test -> e6 [color="#e34948", style=dashed];
  cap -> sel [label=" 8 configurations"];
  valid -> sel [color="#c98500", style=dashed, label=" validation"];
  sel -> tf;
  test -> tf [color="#e34948", style=dashed];
  e6 -> met [arrowhead=none, style=dotted]; tf -> met [arrowhead=none, style=dotted];
  e6 -> dash; sel -> dash; tf -> dash;
  dash -> rep [style=dotted, arrowhead=none]; ui -> rep [style=dotted, arrowhead=none];
  p3 -> fut [style=dashed, color="#9a9994", label=" not used in\n scoring yet"];
  tf -> fut [style=invis];

  subgraph cluster_legend {
    label=<<B>Legend</B>>; style="rounded"; color="#9a9994"; fontsize=11;
    l1 [label="Training data / training-only processing", fillcolor="#dcecdc", color="#008300"];
    l2 [label="Validation: rule review and cap selection", fillcolor="#fff3d6", color="#c98500"];
    l3 [label="Test: evaluation only (used twice)", fillcolor="#fde3e3", color="#e34948"];
    l4 [label="Interactive interface", fillcolor="#e9e6fb", color="#6250d6"];
    l5 [label="Implemented processing stage", fillcolor="#eaf2fc", color="#2a78d6"];
    l6 [label="Proposed, not implemented", style="rounded,dashed", fillcolor="white", color="#9a9994"];
    l1 -> l2 -> l3 [style=invis]; l4 -> l5 -> l6 [style=invis];
  }
  {rank=same; labels; train; valid; test}
  labels -> train -> valid -> test [style=invis];
  {rank=same; sel; ui}
}
